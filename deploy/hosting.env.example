POWERALL_DOMAIN=energy.example.com
POWERALL_ACME_EMAIL=operator@example.com
POWERALL_OPERATOR_NAME=Your service operator name
POWERALL_PRIVACY_CONTACT=privacy@example.com
POWERALL_HOSTING_LOCATION=United Kingdom; name your hosting provider
POWERALL_PRIVACY_LEGAL_BASIS=Replace with the purpose and lawful basis applicable to your service
# Optional registration capacity: empty means no account ceiling.
POWERALL_MAX_ACCOUNTS=
# Per-process database pool; total connections must fit PostgreSQL max_connections.
POWERALL_DB_POOL_SIZE=8
# Global provider call spacing shared by all import workers.
POWERALL_PROVIDER_INTERVAL_SECONDS=1
POWERALL_BRIGHT_ENABLED=true
# Optional override; leave empty to use the existing Bright consumer application ID.
POWERALL_BRIGHT_APPLICATION_ID=
# Nginx Proxy Manager mode (compose.npm.yaml only).
# Dedicated Docker network containing NPM and Powerall's gateway, not other apps.
# POWERALL_PROXY_NETWORK=powerall_proxy
# Pin NPM's address on that network, then trust that exact address only.
# POWERALL_TRUSTED_PROXY_CIDRS=172.30.50.2/32
